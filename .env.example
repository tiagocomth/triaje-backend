# ─────────────────────────────────────────────────────────────
# TriagemAI — Backend configuration
# Copy this file to `.env` and adjust the values for your machine.
# ─────────────────────────────────────────────────────────────

# ── HTTP server ──────────────────────────────────────────────
# Port the API listens on. The frontend expects 3000 by default.
PORT=3000

# Node environment: "development" | "production" | "test"
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────
# Origin allowed to call the API. In dev this is the Vite frontend.
# In production set it to your published frontend domain.
CORS_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────────────
# Path (relative to project root or absolute) to the SQLite file.
DATABASE_PATH=./data/triagemai.db

# ── File uploads ─────────────────────────────────────────────
# Directory where uploaded CVs are stored.
UPLOAD_DIR=./uploads
# Max upload size per file, in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760

# ── AI provider chain ────────────────────────────────────────
# The AI service tries providers in this order until one succeeds:
#   ollama  -> groq  -> heuristic
# Comma-separated. Remove a provider to skip it entirely.
AI_PROVIDER_CHAIN=ollama,groq,heuristic

# Per-request timeout for an AI provider call, in milliseconds.
AI_REQUEST_TIMEOUT_MS=60000

# ── Ollama (local LLM) ───────────────────────────────────────
# Base URL of your local Ollama server and the model to use.
# Install: https://ollama.com  — then: `ollama pull llama3`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Groq (free cloud fallback) ───────────────────────────────
# Get a free API key at https://console.groq.com/keys
# Leave GROQ_API_KEY empty to disable the Groq fallback.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
